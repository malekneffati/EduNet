# Configuration Paymee
# ⚠️ REMPLACEZ CES VALEURS PAR VOS VRAIES CLÉS PAYMEE

# Clé API Paymee (obtenue depuis votre compte Paymee)
PAYMEE_API_KEY=votre_cle_api_paymee_ici

# ID du vendeur Paymee
PAYMEE_VENDOR_ID=votre_vendor_id_ici

# Environnement (sandbox ou production)
PAYMEE_ENV=sandbox

# Port du serveur
PORT=10000

# URLs de retour
RETURN_URL=https://edunet.com/payment/success
CANCEL_URL=https://edunet.com/payment/cancel
WEBHOOK_URL=https://votre-domaine.com/webhook/paymee

# ========================================
# COMMENT OBTENIR VOS CLÉS PAYMEE :
# ========================================
# 1. Créez un compte sur https://paymee.tn
# 2. Connectez-vous à votre tableau de bord
# 3. Allez dans "Paramètres" > "API"
# 4. Copiez votre "API Key" et "Vendor ID"
# 5. Collez-les ci-dessus
# ========================================
